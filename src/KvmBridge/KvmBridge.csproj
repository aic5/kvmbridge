<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KvmBridge</AssemblyName>
    <Version>1.1.0</Version>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/src/KvmBridge</PathMap>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="*.cs;*.py;KvmBridge.csproj;README.md;packages.lock.json" />
    <EmbeddedResource Include="../../global.json" LogicalName="KvmBridge.global.json" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="KvmBridge.LICENSE" />
    <EmbeddedResource Include="../../NOTICE" LogicalName="KvmBridge.NOTICE" />
    <EmbeddedResource Include="../../third-party/*.txt" LogicalName="KvmBridge.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
